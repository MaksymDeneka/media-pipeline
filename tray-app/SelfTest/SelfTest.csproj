<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UploadSelfTest</AssemblyName>
    <RootNamespace>MediaPipelineTray.SelfTest</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Link the chunking and assembly source rather than referencing the WPF executable, so
         the test needs no desktop stack and can run headless. -->
    <Compile Include="..\Services\FileChunker.cs" Link="FileChunker.cs" />
    <Compile Include="..\Services\UploadService.cs" Link="UploadService.cs" />
    <Compile Include="..\Services\PipelinePaths.cs" Link="PipelinePaths.cs" />
    <Compile Include="..\Services\IniFile.cs" Link="IniFile.cs" />
    <Compile Include="..\Services\PipelineMonitor.cs" Link="PipelineMonitor.cs" />
    <Compile Include="..\Services\EventStreamReader.cs" Link="EventStreamReader.cs" />
    <Compile Include="..\Services\WatcherService.cs" Link="WatcherService.cs" />
    <Compile Include="..\Models\PipelineModels.cs" Link="PipelineModels.cs" />
    <Compile Include="..\Services\ArchiveService.cs" Link="ArchiveService.cs" />
  </ItemGroup>

</Project>
