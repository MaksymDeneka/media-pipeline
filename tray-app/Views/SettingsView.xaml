<UserControl x:Class="MediaPipelineTray.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">

    <DockPanel>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SunkBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10"
                Visibility="{Binding IsDirty, Converter={StaticResource TrueToVisible}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding DirtyNote}" Style="{StaticResource Body}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Discard" Click="OnDiscard" />
                    <Button Content="Save and restart" Style="{StaticResource StrongButton}"
                            Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,20">

                <TextBlock Text="Defaults" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource InkBrush}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" MaxWidth="620"
                           HorizontalAlignment="Left"
                           Text="These are the defaults every preset inherits. A preset only needs to list the values it wants to differ, which is why most presets are two or three lines." />

                <TextBlock Text="{Binding ConfigPath}" Style="{StaticResource Mono}" Margin="0,10,0,0" />

                <!-- A Windows setting rather than a pipeline one, so it sits apart from the
                     generated fields and applies immediately instead of on save. -->
                <TextBlock Text="APPLICATION" Style="{StaticResource Caption}" Margin="0,20,0,2" />

                <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1"
                        Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="Start with Windows" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}" />
                            <TextBlock Text="{Binding StartupNote}" Style="{StaticResource Hint}"
                                       Margin="0,1,0,0" />
                            <TextBlock Style="{StaticResource Caption}" FontWeight="Normal" Margin="0,3,0,0"
                                       Text="Applies straight away. The watcher has its own scheduled task and starts regardless." />
                        </StackPanel>

                        <CheckBox Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding StartWithWindows}" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Groups}" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}"
                                           Margin="0,0,0,2" />
                                <ItemsControl ItemsSource="{Binding Rows}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
