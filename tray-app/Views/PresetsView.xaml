<UserControl x:Class="MediaPipelineTray.Views.PresetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">

    <DockPanel>

        <!-- Unsaved changes bar. Settings are read at startup, so saving means restarting. -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SunkBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10"
                Visibility="{Binding IsDirty, Converter={StaticResource TrueToVisible}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding DirtyNote}" Style="{StaticResource Body}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Discard" Click="OnDiscard" />
                    <Button Content="Save and restart" Style="{StaticResource StrongButton}"
                            Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Preset list -->
        <Border DockPanel.Dock="Left" Width="210"
                Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Padding="10"
                        BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Add" Margin="0" Click="OnAddPreset" />
                        <Button Content="Remove" Click="OnRemovePreset" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Presets}"
                         SelectedItem="{Binding Selected}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Chrome" Background="Transparent"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource SunkBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource SunkBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="13"
                                       Foreground="{DynamicResource InkBrush}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Selected preset -->
        <Grid>
            <TextBlock Text="No presets are configured. Add one to get started."
                       Style="{StaticResource Hint}"
                       Margin="20"
                       VerticalAlignment="Top"
                       Visibility="{Binding HasSelection, Converter={StaticResource FalseToVisible}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection, Converter={StaticResource TrueToVisible}}">
                <StackPanel Margin="20,16,20,20" DataContext="{Binding Selected}">

                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" />
                    <TextBlock Text="{Binding FolderPath}" Style="{StaticResource Mono}"
                               Margin="0,2,0,0" />

                    <ItemsControl ItemsSource="{Binding Groups}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,18">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}"
                                               Margin="0,0,0,2" />
                                    <ItemsControl ItemsSource="{Binding Rows}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </DockPanel>
</UserControl>
