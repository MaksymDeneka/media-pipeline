<Window x:Class="MediaPipelineTray.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Pipeline"
        SizeToContent="Height"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">

    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource InkBrush}" />

        <TextBlock x:Name="Explanation" Style="{StaticResource Hint}" Margin="0,6,0,0" />

        <TextBox x:Name="Answer" Margin="0,14,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
            <Button Content="OK" IsDefault="True" Style="{StaticResource StrongButton}"
                    Click="OnAccept" />
        </StackPanel>
    </StackPanel>
</Window>
