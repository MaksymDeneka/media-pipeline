<UserControl x:Class="MediaPipelineTray.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MediaPipelineTray"
             Background="{DynamicResource BgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ===== failures ===== -->
            <ItemsControl ItemsSource="{Binding Failures}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="16,14,16,0"
                                Background="{DynamicResource FailBgBrush}"
                                BorderBrush="{DynamicResource FailBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="13,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Width="7" Height="7" Margin="0,0,10,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource FailBrush}" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Lane}"
                                           FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource InkBrush}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Detail}"
                                           Style="{StaticResource Mono}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button Content="Open folder" Click="OnOpenFailedFolder" />
                                    <Button Content="Requeue" Click="OnRequeue" />
                                    <Button Content="Dismiss" Click="OnDismissFailures" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== running ===== -->
            <ContentControl Template="{StaticResource SectionHeadTemplate}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="RUNNING" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Running.Count}" Style="{StaticResource Caption}"
                               Margin="10,0,0,0" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
            </ContentControl>

            <ItemsControl ItemsSource="{Binding Running}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource LineSoftBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Lane}"
                                               FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock Text="{Binding PresetSummary}"
                                               Style="{StaticResource Caption}"
                                               FontWeight="Normal" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Subject}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="12"
                                               Foreground="{DynamicResource InkBrush}"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Full-contrast fill: running is emphatic, not coloured. -->
                                    <ProgressBar Height="4" Margin="0,7"
                                                 Minimum="0" Maximum="1"
                                                 Value="{Binding Fraction, Mode=OneWay}"
                                                 Style="{StaticResource FlatBar}" />

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Counts}" Style="{StaticResource Mono}" />
                                        <TextBlock Text="{Binding Elapsed}" Style="{StaticResource Mono}"
                                                   Margin="16,0,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Percent}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="18"
                                               Foreground="{DynamicResource InkBrush}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Remaining}"
                                               Style="{StaticResource Caption}"
                                               FontWeight="Normal"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Nothing running."
                       Style="{StaticResource Mono}"
                       Margin="16,4,16,12"
                       Visibility="{Binding Running.Count,
                                    Converter={StaticResource ZeroToVisible}}" />

            <!-- ===== queued ===== -->
            <ContentControl Template="{StaticResource SectionHeadTemplate}">
                <TextBlock Text="QUEUED" Style="{StaticResource Caption}" />
            </ContentControl>

            <ItemsControl ItemsSource="{Binding Queued}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource LineSoftBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="16,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Width="7" Height="7" Margin="0,0,10,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource FaintBrush}" />

                                <TextBlock Grid.Column="1" Text="{Binding Lane}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource InkBrush}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                           Style="{StaticResource Mono}"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="3" Content="Pause" Click="OnPauseLane" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Nothing queued."
                       Style="{StaticResource Mono}"
                       Margin="16,4,16,12"
                       Visibility="{Binding Queued.Count,
                                    Converter={StaticResource ZeroToVisible}}" />

            <!-- ===== finished ===== -->
            <ContentControl Template="{StaticResource SectionHeadTemplate}">
                <TextBlock Text="FINISHED" Style="{StaticResource Caption}" />
            </ContentControl>

            <ItemsControl ItemsSource="{Binding Finished}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource LineSoftBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="16,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- The one place green is spent. -->
                                <Ellipse Width="7" Height="7" Margin="0,0,10,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource OkBrush}" />

                                <TextBlock Grid.Column="1" Text="{Binding Lane}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource InkBrush}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                           Style="{StaticResource Mono}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Column="3" Text="{Binding Outputs}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OkBrush}"
                                           VerticalAlignment="Center"
                                           Margin="12,0" />

                                <TextBlock Grid.Column="4" Text="{Binding When}"
                                           Style="{StaticResource Caption}"
                                           FontWeight="Normal"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />

                                <!-- Collect this job's output, optionally sending it straight on. -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal"
                                            Visibility="{Binding CanArchive, Converter={StaticResource TrueToVisible}}">
                                    <Button Content="Zip" Padding="9,2" Click="OnZip"
                                            ToolTip="Collect this job's output into a zip in the workspace sync folder" />
                                    <Button Content="Zip and upload" Padding="9,2" Click="OnZipAndUpload"
                                            ToolTip="Zip it, then queue the archive for upload to the remote" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

</UserControl>
