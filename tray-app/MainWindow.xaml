<Window x:Class="MediaPipelineTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MediaPipelineTray.Views"
        Title="Media Pipeline"
        Height="760" Width="1040"
        MinHeight="460" MinWidth="820"
        Background="{DynamicResource BgBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">

    <DockPanel>

        <!-- Status bar, always visible: whatever tab you are on, you can see whether the
             watcher is alive and stop or restart it. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10"
                DataContext="{Binding Activity}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Width="7" Height="7" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource InkBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WatcherRunning}" Value="False">
                                    <Setter Property="Fill" Value="{DynamicResource FaintBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                           FontWeight="SemiBold" FontSize="12.5"
                           Foreground="{DynamicResource InkBrush}"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="2" Text="{Binding StatusMeta}"
                           Style="{StaticResource Mono}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="Start" Click="OnStart"
                            Visibility="{Binding WatcherRunning, Converter={StaticResource FalseToVisible}}" />
                    <Button Content="{Binding PauseAllLabel}" Click="OnPauseAll"
                            Visibility="{Binding WatcherRunning, Converter={StaticResource TrueToVisible}}" />
                    <Button Content="Restart" Click="OnRestart"
                            Visibility="{Binding WatcherRunning, Converter={StaticResource TrueToVisible}}" />
                    <Button Content="Stop" Click="OnStop"
                            Visibility="{Binding WatcherRunning, Converter={StaticResource TrueToVisible}}" />
                    <Button Content="Logs" Click="OnOpenLogs" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl SelectionChanged="OnTabChanged">
            <TabItem Header="Activity">
                <views:ActivityView DataContext="{Binding Activity}" />
            </TabItem>
            <TabItem Header="Presets">
                <views:PresetsView DataContext="{Binding Presets}" />
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
            <TabItem Header="Uploads">
                <views:UploadsView DataContext="{Binding Uploads}" />
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
